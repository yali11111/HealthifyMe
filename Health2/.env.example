POSTGRES_DB=BottomNavMenu

POSTGRES_ADMIN_USER=BottomNavMenu_admin
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

BottomNavMenu_DB_USER=BottomNavMenu_app
BottomNavMenu_DB_PASSWORD=CHANGE_ME_APP_PASSWORD

POSTGRES_PORT=5432
