<?xml version="1.0" encoding="utf-8"?>

<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.BottomNavMenu.presentation.ui.fragments.HomeFragment"
        android:label="Accueil">

        <action
            android:id="@+id/action_home_to_add"
            app:destination="@id/addFragment"/>

        <action
            android:id="@+id/action_home_to_view"
            app:destination="@id/viewFragment"/>

    </fragment>

    <fragment
        android:id="@+id/addFragment"
        android:name="com.example.BottomNavMenu.presentation.ui.fragments.AddFragment"
        android:label="Ajouter">

        <action
            android:id="@+id/action_add_to_home"
            app:destination="@id/homeFragment"/>

    </fragment>

    <fragment
        android:id="@+id/viewFragment"
        android:name="com.example.BottomNavMenu.presentation.ui.fragments.ViewFragment"
        android:label="Statistiques">

        <action
            android:id="@+id/action_view_to_home"
            app:destination="@id/homeFragment"/>

    </fragment>

</navigation>
